{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "echo 'API only: the web app is published to GitHub Pages'"
  },
  "deploy": {
    "preDeployCommand": ["npm run seed -w server"],
    "startCommand": "node --max-old-space-size=192 --max-semi-space-size=4 server/src/server.js",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 75
  }
}
