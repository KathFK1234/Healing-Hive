# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=7002

MONGO_URI=mongodb://127.0.0.1:27017/healing-hive

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the web app is served from (comma-separated for several)
CLIENT_ORIGIN=http://localhost:5173

# AI companion (Claude). Get a key at https://console.anthropic.com
# Leave the key empty to run without it: the chat page then explains it is
# switched off and still shows crisis contacts.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Outgoing email (password resets, booking and application updates).
# Leave SMTP_HOST empty in development: emails are printed in the server log.
# For Gmail: host smtp.gmail.com, port 465, your address, and an "app password"
# from https://myaccount.google.com/apppasswords (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Healing Hive <no-reply@example.com>

# Google Calendar and Meet for professionals. Create an OAuth client of type
# "Web application" at https://console.cloud.google.com/apis/credentials, enable
# the Google Calendar API, and add this authorised redirect URI:
#   <API_URL>/api/v1/google/callback
# Leave empty to hide the option; video sessions then use the professional's
# own meeting link or a Jitsi room.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed when deployed: the public addresses of the web app and this API.
# Locally they default to CLIENT_ORIGIN and http://localhost:<PORT>.
CLIENT_URL=
API_URL=

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
