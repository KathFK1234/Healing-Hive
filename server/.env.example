# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=7002

MONGO_URI=mongodb://127.0.0.1:27017/healing-hive

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the web app is served from (comma-separated for several)
CLIENT_ORIGIN=http://localhost:5173

# AI companion. Leave the key empty to run without it: the chat page then
# explains it is switched off and still shows crisis contacts.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
